# Production Environment Configuration Template (Phase 8 Step 5C)
# =============================================================================
# USAGE INSTRUCTIONS:
# 1. For Production Runtime:
#      Copy this template to server/.env.production
#      Set credentials for the runtime user (readWrite on apple_worm_adventure only)
# 2. For Production Migration Operator:
#      Copy this template to server/.env.production.operator
#      Set credentials for the operator user (readWrite + dbAdmin on apple_worm_adventure only)
# 3. Both files are strictly excluded from git via .gitignore. Never commit actual secrets!
# =============================================================================

# Application & Environment
NODE_ENV=production
PORT=5000
GAME_NAME=APPLE WORM ADVENTURE

# Target Production Database
# Must be the dedicated production database "apple_worm_adventure"
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/apple_worm_adventure?retryWrites=true&w=majority

# Target Validation Gates (Fail-closed enforcement in validateMigrationTarget)
# Must match URI database name path character-for-character:
MIGRATION_EXPECTED_DB_NAME=apple_worm_adventure
# Comma-separated list of approved production hostnames:
MIGRATION_ALLOWED_HOSTS=<cluster>.mongodb.net,127.0.0.1,localhost

# Authentication
# Must be a secure random secret of at least 32 characters:
JWT_SECRET=replace_with_a_secure_production_jwt_secret_at_least_32_chars
JWT_EXPIRES_IN=7d

# Wallet Accounting & Integrity (Phase 8)
# Mandatory in production (NODE_ENV=production):
# Must be a secure random secret of at least 32 characters, unique to production.
WALLET_INTEGRITY_SECRET=replace_with_a_secure_production_wallet_secret_at_least_32_characters_long

# Optional: Previous secret for zero-downtime key rotation.
# WALLET_INTEGRITY_SECRET_PREVIOUS=previous_production_secret_during_rotation_window

# Background Wallet Recovery Scheduler Settings
WALLET_RECOVERY_INTERVAL_MS=60000
WALLET_RECOVERY_BATCH_SIZE=50
WALLET_CACHE_RECONCILIATION_BATCH_SIZE=100
