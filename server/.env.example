# Backend Environment Configuration
PORT=5000
NODE_ENV=development

# Database
MONGODB_URI=your_mongodb_connection_string

# Staging Migration Target Validation (Phase 8 Step 5A-4)
# Fail-closed target validation ensures migration scripts never connect to unexpected
# or production clusters. Both variables are strictly required when executing migration scripts.
#
# Exact expected database name (must match URI path exactly, case-sensitive):
MIGRATION_EXPECTED_DB_NAME=apple_worm_staging
#
# Comma-separated allowlist of approved hostnames/endpoints (ports optional):
MIGRATION_ALLOWED_HOSTS=cluster0.staging.mongodb.net,127.0.0.1,localhost

# Authentication
JWT_SECRET=replace_with_a_secure_secret
JWT_EXPIRES_IN=7d

# Wallet Accounting & Integrity (Phase 8)
# Mandatory in production (NODE_ENV=production): Must be a secure random secret of at least 32 characters.
WALLET_INTEGRITY_SECRET=replace_with_a_secure_secret_at_least_32_characters_long

# Optional: Previous secret for zero-downtime key rotation. Set during secret rotation transition windows.
# WALLET_INTEGRITY_SECRET_PREVIOUS=previous_secret_during_rotation_window

# Background Wallet Recovery Scheduler Settings
# Recovery interval in milliseconds (default: 60000ms / 1 minute; minimum: 10000ms)
WALLET_RECOVERY_INTERVAL_MS=60000

# Bounded batch size for wallet recovery processing (default: 50 wallets per batch)
WALLET_RECOVERY_BATCH_SIZE=50

# Bounded limit for stale User.coins cache reconciliation discovery (default: 100 users per batch)
WALLET_CACHE_RECONCILIATION_BATCH_SIZE=100
