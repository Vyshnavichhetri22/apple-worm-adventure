# Staging Environment Configuration Template (Backend)
# =============================================================================
# USAGE INSTRUCTIONS:
# 1. Copy this template to server/.env.staging:
#      cp server/.env.staging.example server/.env.staging
# 2. Populate server/.env.staging with verified staging credentials.
# 3. server/.env.staging is excluded from git via .gitignore. Never commit actual secrets.
# 4. Run migration scripts explicitly targeting staging:
#      node server/scripts/migrate-wallet-idempotency-index.js --env-file=server/.env.staging
# =============================================================================

# Application & Environment
NODE_ENV=staging
PORT=5000
GAME_NAME=APPLE WORM ADVENTURE

# Target Staging Database (Must be an isolated staging cluster; never production!)
MONGODB_URI=mongodb+srv://<staging_username>:<staging_password>@<staging_cluster>.mongodb.net/apple_worm_staging?retryWrites=true&w=majority

# Target Identity Validation Gates (Fail-closed enforcement in validateMigrationTarget)
# Must match URI database name path character-for-character:
MIGRATION_EXPECTED_DB_NAME=apple_worm_staging
# Comma-separated list of approved staging hostnames (ports optional):
MIGRATION_ALLOWED_HOSTS=<staging_cluster>.mongodb.net,127.0.0.1,localhost

# Authentication
JWT_SECRET=replace_with_a_secure_staging_jwt_secret_at_least_32_chars
JWT_EXPIRES_IN=7d

# Wallet Accounting & Integrity (Phase 8)
# Mandatory: Must be a secure random secret of at least 32 characters, unique to staging.
WALLET_INTEGRITY_SECRET=replace_with_a_secure_staging_wallet_secret_at_least_32_characters_long

# Optional: Previous secret for zero-downtime key rotation.
# WALLET_INTEGRITY_SECRET_PREVIOUS=previous_staging_secret_during_rotation_window

# Background Wallet Recovery Scheduler Settings
WALLET_RECOVERY_INTERVAL_MS=60000
WALLET_RECOVERY_BATCH_SIZE=50
WALLET_CACHE_RECONCILIATION_BATCH_SIZE=100
